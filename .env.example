# INF-001 — пример переменных окружения. Реальных секретов нет.
# Скопируйте в .env (он в .gitignore) и при необходимости переопределите.
# Значения по умолчанию совпадают с docker-compose.yml; для smoke-теста
# локально можно оставить как есть.

# DSN подключения к PostgreSQL. Формат psycopg3 (SQLAlchemy 2.x).
DATABASE_URL=postgresql+psycopg://d2intel:d2intel_dev@localhost:5432/d2intel

# Имя приложения (просто метка).
APP_NAME=d2intel

# Режим отладки (0/1). В проде не используется — локальный инструмент.
DEBUG=0

# Зарезервировано для будущих задач (INF-002 конфиг/секреты, ING-001 токены
# источников). Здесь намеренно НЕТ значений — ключи не выдумываются и не
# коммитятся. Любой источник включается только после отдельного gate.
# OPENDOTA_API_KEY=
# STRATZ_API_KEY=
# LIQUIPEDIA_USER_AGENT=
